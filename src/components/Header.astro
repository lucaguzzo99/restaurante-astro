<div class="barra">
	<header class="barra-top">
		<div class="contenedor barra-in">
			<a class="logo" href="#inicio">
				<span class="logo-marca" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v8a2 2 0 0 0 2 2v8M10 3v8a2 2 0 0 1-2 2M8 3v6M17 3c-2 1.5-3 4-3 7 0 2 1 3 3 3v8"></path></svg>
				</span>
				Sabores del Sur
			</a>
			<button class="tema" id="tema" type="button" aria-label="Cambiar entre modo día y modo noche" title="Cambiar modo">
				<svg class="i-luna" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
				<svg class="i-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path></svg>
				<span class="tema-txt" id="tema-txt">Modo noche</span>
			</button>
			<a class="btn btn-sm" href="#reservas">Reservar</a>
		</div>
	</header>
	<nav class="barra-nav" aria-label="Principal">
		<div class="contenedor barra-links">
			<a href="#menu">Menú</a>
			<a href="#delivery">Delivery</a>
			<a href="#horarios">Horarios</a>
			<a href="#reservas">Reservas</a>
			<a href="https://lucaguzzo99.github.io/mantenimiento0/">Inicio</a>
			<a href="http://mascotas.estilo.digital/">Mascotas</a>
			<a href="http://mercadovirtual.estilo.digital/">Mercado Virtual</a>
		</div>
	</nav>
</div>

<script>
	// Tema día / noche
	const raiz = document.documentElement;
	const boton = document.getElementById('tema')!;
	const texto = document.getElementById('tema-txt')!;

	function pintarTema() {
		const oscuro = raiz.getAttribute('data-theme') === 'dark';
		texto.textContent = oscuro ? 'Modo día' : 'Modo noche';
		boton.setAttribute('aria-pressed', oscuro ? 'true' : 'false');
	}

	boton.addEventListener('click', () => {
		const nuevo = raiz.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
		raiz.setAttribute('data-theme', nuevo);
		try {
			localStorage.setItem('tema-sabores', nuevo);
		} catch (e) {}
		pintarTema();
	});
	pintarTema();
</script>

