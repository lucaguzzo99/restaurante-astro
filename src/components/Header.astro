	.logo {
		color: var(--ink);
		align-items: center;
		gap: 0.6rem;
		margin-right: auto;
		font-family: Fraunces, Georgia, serif;
		font-size: 1.3rem;
		font-weight: 700;
		text-decoration: none;
		display: flex;
	}
	.logo-marca {
		background: var(--accent);
		width: 2.2rem;
		height: 2.2rem;
		color: var(--accent-ink);
		border-radius: 12px;
		place-items: center;
		display: grid;
	}
	.logo-marca svg { width: 1.2rem; height: 1.2rem; }
	.barra nav { border-top: 1px solid var(--line); }
	.barra-links { gap: 1.4rem; padding-block: 0.45rem; display: flex; justify-content: center; overflow-x: auto; white-space: nowrap; }
	.barra nav a { color: var(--muted); font-size: 0.95rem; font-weight: 600; text-decoration: none; transition: color 0.2s; }
	.barra nav a:hover { color: var(--accent); }
	@media (width <= 760px) {
		.barra-links { justify-content: flex-start; }
	}

	.tema {
		border: 1px solid var(--line);
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		cursor: pointer;
		border-radius: 999px;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.95rem;
		font-size: 0.88rem;
		font-weight: 600;
		transition: border-color 0.2s, transform 0.2s;
		display: inline-flex;
	}
	.tema:hover { border-color: var(--accent); transform: translateY(-1px); }
	.tema svg { width: 1.1rem; height: 1.1rem; }
	.i-sol { color: var(--gold); display: none; }
	:global(:root[data-theme='dark']) .i-sol { display: block; }
	:global(:root[data-theme='dark']) .i-luna { display: none; }
	@media (width <= 520px) {
		.tema-txt { display: none; }
	}
</style>
