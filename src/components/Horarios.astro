---
import { HORARIOS } from '../data/restaurante';
import { hm } from '../scripts/utils';

// Lunes a domingo
const semana = [1, 2, 3, 4, 5, 6, 0].map((d) => ({ d, ...HORARIOS[d] }));

const especiales = [
	{ icono: '🍹', dia: 'Viernes', titulo: 'Noche de viernes', items: ['Abrimos de 12:00 a 00:30', 'Happy hour de 18:00 a 20:00', 'Cocina abierta hasta las 23:30'] },
	{ icono: '🥐', dia: 'Sábado', titulo: 'Brunch y noche larga', items: ['Abrimos de 11:00 a 01:00', 'Brunch de 11:00 a 14:00', 'Música en vivo desde las 22:00'] },
	{ icono: '🍖', dia: 'Domingo', titulo: 'Almuerzo en familia', items: ['Abrimos de 11:00 a 17:00', 'Menú de domingo con parrilla libre', 'Sin servicio de cena'] },
];
---

<section class="seccion suave" id="horarios">
	<div class="contenedor">
		<header class="cabecera reveal">
			<span class="sobretitulo">Horarios</span>
			<h2>Cuándo <em>visitarnos</em></h2>
			<p>Abrimos todos los días. El fin de semana tenemos horarios y propuestas especiales.</p>
		</header>
		<div class="horarios-in">
			<div class="tabla-caja reveal">
				<h3>Semana completa</h3>
				<table class="tabla">
					<thead>
						<tr><th scope="col">Día</th><th scope="col">Apertura</th><th scope="col">Cierre</th></tr>
					</thead>
					<tbody>
						{
							semana.map((h) => (
								<tr id={`dia-${h.d}`} class={h.especial ? 'fila-esp' : undefined}>
									<th scope="row">
										{h.dia}
										{h.especial && <small>Horario especial</small>}
									</th>
									<td>{hm(h.abre)} h</td>
									<td>{hm(h.cierra)} h</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<p class="nota">El horario de hoy aparece resaltado. Los cierres pasada la medianoche corresponden al día siguiente.</p>
			</div>
			<div class="especiales">
				{
					especiales.map((e) => (
						<article class="especial reveal">
							<span class="esp-icono" aria-hidden="true">{e.icono}</span>
							<div>
								<small>{e.dia}</small>
								<h3>{e.titulo}</h3>
								<ul>{e.items.map((i) => <li>{i}</li>)}</ul>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	// Resalta la fila del día actual
	function marcarHoy() {
		document.querySelectorAll('.tabla tbody tr').forEach((f) => f.classList.remove('hoy'));
		document.getElementById('dia-' + new Date().getDay())?.classList.add('hoy');
	}
	marcarHoy();
	setInterval(marcarHoy, 60000);
</script>

<style>
	.horarios-in { grid-template-columns: 1fr 1fr; align-items: start; gap: 1.7rem; display: grid; }
	@media (width <= 860px) {
		.horarios-in { grid-template-columns: 1fr; }
	}
	.tabla-caja { background: var(--surface); border: 1px solid var(--line); border-radius: 24px; padding: 1.8rem; }
	.tabla-caja h3 { margin-bottom: 1rem; font-family: Fraunces, Georgia, serif; font-size: 1.5rem; }
	.tabla { border-collapse: collapse; width: 100%; }
	.tabla th, .tabla td { text-align: left; border-bottom: 1px solid var(--line); padding: 0.8rem 0.5rem; }
	.tabla thead th { color: var(--muted); letter-spacing: 0.07em; text-transform: uppercase; font-size: 0.78rem; }
	.tabla tbody th { font-weight: 700; }
	.tabla small { color: var(--accent); font-size: 0.72rem; font-weight: 600; display: block; }
	.tabla td { font-variant-numeric: tabular-nums; }
	.tabla tbody tr:last-child th, .tabla tbody tr:last-child td { border-bottom: 0; }
	.tabla tr.hoy { background: color-mix(in srgb, var(--accent) 12%, transparent); }
	.tabla tr.hoy th::after {
		content: 'HOY';
		background: var(--accent);
		color: var(--accent-ink);
		letter-spacing: 0.08em;
		vertical-align: middle;
		border-radius: 999px;
		margin-left: 0.6rem;
		padding: 0.1rem 0.5rem;
		font-size: 0.65rem;
	}
	.nota { color: var(--muted); margin-top: 1rem; font-size: 0.82rem; }

	.especiales { gap: 1rem; display: grid; }
	.especial {
		background: var(--surface);
		border: 1px solid var(--line);
		border-left: 5px solid var(--gold);
		border-radius: 20px;
		gap: 1.1rem;
		padding: 1.4rem 1.5rem;
		transition: transform 0.25s;
		display: flex;
	}
	.especial:hover { transform: translateX(6px); }
	.esp-icono {
		background: color-mix(in srgb, var(--gold) 20%, transparent);
		border-radius: 16px;
		flex: none;
		place-items: center;
		width: 3.2rem;
		height: 3.2rem;
		font-size: 1.6rem;
		display: grid;
	}
	.especial small { color: var(--accent); text-transform: uppercase; letter-spacing: 0.07em; font-size: 0.72rem; font-weight: 700; }
	.especial h3 { margin-bottom: 0.4rem; font-size: 1.1rem; }
	.especial ul { color: var(--muted); margin: 0; padding-left: 1.1rem; font-size: 0.92rem; }
</style>
